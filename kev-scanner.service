[Unit]
Description=CISA KEV Emerging Threat Scanner
Documentation=https://github.com/ob1sec/PayloadZer0
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=security
Group=security
WorkingDirectory=/opt/kev-scanner

# Environment
Environment="PYTHONUNBUFFERED=1"
Environment="TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR_WEBHOOK_HERE"

# Main execution
ExecStart=/usr/bin/python3 /opt/kev-scanner/payloadZer0.py \
    -t /opt/kev-scanner/hosts.txt \
    --continuous \
    --interval 3600 \
    --output-dir /var/log/kev-scans \
    --rate-limit 150 \
    --scan-timeout 10

# Restart policy
Restart=always
RestartSec=60
StartLimitBurst=3
StartLimitInterval=600

# Logging
StandardOutput=append:/var/log/kev-scanner/stdout.log
StandardError=append:/var/log/kev-scanner/stderr.log
SyslogIdentifier=kev-scanner

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/kev-scanner /var/log/kev-scanner /var/log/kev-scans

# Resource limits
LimitNOFILE=65536
MemoryMax=2G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
